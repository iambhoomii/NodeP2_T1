generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentGateway {
  RAZORPAY
}

model Payment {
  id                   String         @id @default(uuid())
  applicationId        String
  amount               Int
  currency             String         @default("INR")
  gateway              PaymentGateway @default(RAZORPAY)
  status               PaymentStatus  @default(PENDING)
  razorpayOrderId      String?        @unique
  idempotencyKey String? @unique
  razorpayPaymentId    String?
  razorpaySignature    String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  receiptNumber        String?        @unique
  refundId             String?        @unique
  refundReason         String?
  refundedAt           DateTime?
  receiptIssued        Boolean        @default(false)
  reconciliationStatus String         @default("PENDING")
  refundedAmount       Int?
  failureReason        String?
  application          Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  password     String
  role         String        @default("COMPANY_ADMIN")
  companyId    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]
  company      Company?      @relation(fields: [companyId], references: [id])
}

model Company {
  id          String      @id @default(uuid())
  name        String
  email       String      @unique
  phone       String?
  website     String?
  industry    String?
  description String?
  location    String?
  logo        String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  kyc         CompanyKYC?
  jobs        Job[]
  users       User[]
}

model Job {
  id             String           @id @default(uuid())
  title          String
  description    String
  location       String?
  experience     String?
  assessmentLink String           @unique
  companyId      String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  applications   Application[]
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  thresholds     SkillThreshold[]
}

model SkillThreshold {
  id        String   @id @default(uuid())
  skill     String
  threshold Int
  jobId     String
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model CompanyKYC {
  id             String    @id @default(uuid())
  companyId      String    @unique
  documentType   String
  documentNumber String
  documentUrl    String?
  status         String    @default("PENDING")
  submittedAt    DateTime  @default(now())
  verifiedAt     DateTime?
  company        Company   @relation(fields: [companyId], references: [id])
}

model Application {
  id        String    @id @default(uuid())
  studentId String
  jobId     String
  status    String    @default("APPLIED")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  student   User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payments  Payment[]
  offer     Offer?

  @@unique([studentId, jobId])
}

enum OfferStatus {
  GENERATED
  SENT
  SIGNED
  REJECTED
}

model Offer {
  id               String      @id @default(uuid())
  applicationId    String      @unique
  offerNumber      String      @unique
  candidateName    String
  companyName      String
  jobTitle         String
  salary           Int
  joiningDate      DateTime
  expiryDate       DateTime
  status           OfferStatus @default(GENERATED)

  eSignProvider    String?
  signed           Boolean     @default(false)
  signedAt         DateTime?
  signatureHash    String?

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  application      Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}