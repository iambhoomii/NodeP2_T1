generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentGateway {
  RAZORPAY
}

model Payment {
  id String @id @default(uuid())

  applicationId String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  amount Int
  currency String @default("INR")

  gateway PaymentGateway @default(RAZORPAY)
  status PaymentStatus @default(PENDING)

  razorpayOrderId String? @unique
  razorpayPaymentId String?
  razorpaySignature String?

  // Receipt
  receiptIssued Boolean @default(false)
  receiptNumber String? @unique

  // Refund
  refundId String? @unique
  refundReason String?
  refundedAmount Int?
  refundedAt DateTime?

  // Reconciliation
  reconciliationStatus String @default("PENDING")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String
  role     String @default("COMPANY_ADMIN")

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id String @id @default(uuid())

  name        String
  email       String  @unique
  phone       String?
  website     String?
  industry    String?
  description String?
  location    String?
  logo        String?

  users User[]
  jobs Job[]
  kyc CompanyKYC?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Job {
  id             String   @id @default(uuid())
  title          String
  description    String
  location       String?
  experience     String?
  assessmentLink String   @unique

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  thresholds SkillThreshold[]
  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SkillThreshold {
  id        String @id @default(uuid())

  skill     String
  threshold Int

  jobId String
  job   Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model CompanyKYC {
  id String @id @default(uuid())

  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id])

  documentType   String
  documentNumber String
  documentUrl    String?

  status String @default("PENDING")

  submittedAt DateTime  @default(now())
  verifiedAt  DateTime?
}

model Application {
  id String @id @default(uuid())

  studentId String
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  jobId String
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  status String @default("APPLIED")

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, jobId])
}